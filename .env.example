# Supabase — service role only, never exposed to the browser.
# There is deliberately no NEXT_PUBLIC_SUPABASE_* key in this project.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Resend
RESEND_API_KEY=
# Where enquiries are delivered. Comma separated.
ENQUIRY_NOTIFY_TO=
# Verified sending identity, e.g. "Consultants RS <hello@mail.consultantsrs.com>"
ENQUIRY_FROM=
# Real inbox that replies should go to. Never a noreply address.
ENQUIRY_REPLY_TO=

# Cloudflare Turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Upstash Redis, for rate limiting
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Salt for hashing submitter IPs. Any long random string.
IP_HASH_SALT=

# Shared secret for the outbox drain / keep-alive cron route.
CRON_SECRET=

# Canonical origin, used for metadata and the sitemap.
NEXT_PUBLIC_SITE_URL=https://consultantsrs.com
