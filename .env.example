# ---- Supabase ----------------------------------------------------------
# Service role only, never exposed to the browser. There is deliberately no
# NEXT_PUBLIC_SUPABASE_* key in this project: nothing in the browser talks to
# Postgres. Copy the service role key from Project Settings > API Keys.
SUPABASE_URL=https://oicqkhyackoqtjqsrgro.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# ---- Resend ------------------------------------------------------------
RESEND_API_KEY=
# Where enquiries are delivered. Comma separated for more than one.
ENQUIRY_NOTIFY_TO=info@consultantsrs.com
# Must be on a verified Resend domain.
ENQUIRY_FROM=Consultants RS <hello@mail.consultantsrs.com>
# Real inbox that replies to the receipt should reach. Never a noreply address.
ENQUIRY_REPLY_TO=info@consultantsrs.com

# ---- Cloudflare Turnstile ----------------------------------------------
# Optional. With these unset the form still works and the honeypot, timing and
# rate limit still apply; the server logs a warning so the gap is visible.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ---- Secrets -----------------------------------------------------------
# Any long random string. Rotating it orphans existing rate limit history,
# which is harmless.
IP_HASH_SALT=
# Protects /api/cron/outbox. Vercel sends this as a bearer token.
CRON_SECRET=

# ---- Site --------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://consultantsrs.com
